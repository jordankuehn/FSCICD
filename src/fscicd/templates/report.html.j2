<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>FSCICD Report — {{ result.project_name }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; background: #0d1117; color: #e6edf3; }
  header { padding: 24px 32px; border-bottom: 1px solid #30363d; background: #161b22; }
  h1 { margin: 0 0 4px; font-size: 20px; }
  .sub { color: #8b949e; font-size: 13px; }
  main { padding: 24px 32px; max-width: 1100px; margin: 0 auto; }
  .pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .PASSED { background: #1a7f37; color: #fff; }
  .FAILED { background: #cf222e; color: #fff; }
  .SKIPPED { background: #6e7681; color: #fff; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0 28px; font-size: 13px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #30363d; }
  th { color: #8b949e; font-weight: 600; }
  .cap { border: 1px solid #30363d; border-radius: 8px; padding: 16px 20px; margin-bottom: 20px; background: #161b22; }
  .cap h2 { font-size: 16px; margin: 0 0 4px; display: flex; gap: 10px; align-items: center; }
  .sev-high { color: #ff7b72; font-weight: 600; }
  .sev-medium { color: #d29922; }
  .sev-low { color: #8b949e; }
  code { background: #21262d; padding: 1px 6px; border-radius: 4px; }
</style>
</head>
<body>
<header>
  <h1>FSCICD — {{ result.project_name }}
    <span class="pill {{ result.status.value }}">{{ result.status.value }}</span>
  </h1>
  <div class="sub">Commit <code>{{ result.commit }}</code> · generated {{ generated_at }}</div>
</header>
<main>
  <h2>Summary</h2>
  <table>
    <tr><th>Capability</th><th>Status</th><th>Result</th></tr>
    {% for cap in result.capabilities %}
    <tr>
      <td>{{ cap.name }}</td>
      <td><span class="pill {{ cap.status.value }}">{{ cap.status.value }}</span></td>
      <td>{{ cap.summary }}</td>
    </tr>
    {% endfor %}
  </table>

  {% for cap in result.capabilities %}
  <div class="cap">
    <h2>{{ cap.name }} <span class="pill {{ cap.status.value }}">{{ cap.status.value }}</span></h2>
    <div class="sub">{{ cap.summary }}</div>
    {% if cap.name == "Mass Compile" and cap.details.vis %}
    <table>
      <tr><th>VI</th><th>Status</th><th>Detail</th></tr>
      {% for vi in cap.details.vis %}
      <tr>
        <td><code>{{ vi.path }}</code></td>
        <td>{% if vi.ok %}OK{% elif vi.broken %}BROKEN{% else %}MISSING DEPENDENCY{% endif %}</td>
        <td>{{ vi.message }}{% if vi.missing_dependencies %} (missing: {{ vi.missing_dependencies | join(", ") }}){% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
    {% if cap.name == "VI Analyzer" and cap.details.findings %}
    <table>
      <tr><th>VI</th><th>Test</th><th>Category</th><th>Severity</th><th>Message</th></tr>
      {% for f in cap.details.findings %}
      <tr>
        <td><code>{{ f.vi_path }}</code></td>
        <td>{{ f.test }}</td>
        <td>{{ f.category }}</td>
        <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
        <td>{{ f.message }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
    {% if cap.name == "Unit Tests" and cap.details.cases %}
    <div class="sub">Framework: <code>{{ cap.details.framework }}</code> ·
      passed {{ cap.details.passed }} · failed {{ cap.details.failed }} ·
      errors {{ cap.details.errors }} · skipped {{ cap.details.skipped }}</div>
    <table>
      <tr><th>Test VI</th><th>Case</th><th>Status</th><th>Time (s)</th><th>Message</th></tr>
      {% for c in cap.details.cases %}
      <tr>
        <td><code>{{ c.classname }}</code></td>
        <td>{{ c.name }}</td>
        <td class="{{ 'sev-high' if c.status in ('failed', 'error') else '' }}">{{ c.status }}</td>
        <td>{{ c.duration }}</td>
        <td>{{ c.message }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
  </div>
  {% endfor %}
</main>
</body>
</html>
