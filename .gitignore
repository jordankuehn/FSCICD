# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Editors / OS
.DS_Store
.idea/
